# ── Supabase ─────────────────────────────────────────────────────────────
# Create a project at https://supabase.com/dashboard → New project.
# Then grab Project URL and anon (publishable) key from:
#   Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Sentry (optional, Block 4) ───────────────────────────────────────────
# Create a React Native project at https://sentry.io and paste its DSN.
EXPO_PUBLIC_SENTRY_DSN=

# ── Google OAuth (Block 2) ───────────────────────────────────────────────
# Create OAuth 2.0 Client IDs in Google Cloud Console → Credentials.
# One "Web application" client + one iOS + one Android client.
# The deep-link allow-list in Google must include aliboxing://auth/callback
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=