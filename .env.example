# ── Supabase ─────────────────────────────────────────────────────────────
# Create a project at https://supabase.com/dashboard → New project.
# Then grab Project URL and anon (publishable) key from:
#   Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://leirqcxahyhakntyzson.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_kdIHN4nSVE0LcYEII9tqvw_zb57vKEl

# ── Preview mode (no backend needed) ─────────────────────────────────────
# Set to 1 to run the app against sample in-memory club data. Great for
# seeing the real interface before Supabase is configured. Never ship a
# build with this set to 1: set EXPO_PUBLIC_PREVIEW_MOCK=0 (or unset) and
# provide real EXPO_PUBLIC_SUPABASE_URL / _ANON_KEY instead.
EXPO_PUBLIC_PREVIEW_MOCK=0

# ── Sentry (optional, Block 4) ───────────────────────────────────────────
# Create a React Native project at https://sentry.io and paste its DSN.
EXPO_PUBLIC_SENTRY_DSN=https://c91429d9f1005935a5350d0908266364@o4512100784013312.ingest.de.sentry.io/4512100794171472

# ── Google OAuth (Block 2) ───────────────────────────────────────────────
# Create OAuth 2.0 Client IDs in Google Cloud Console → Credentials.
# One "Web application" client + one iOS + one Android client.
# The deep-link allow-list in Google must include aliboxing://auth/callback
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
